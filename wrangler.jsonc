{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profile-api",
  "main": "worker.js",
  "compatibility_date": "2025-07-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "placement": {
    "mode": "smart",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "keep_vars": true,
  "vars": {
    "PAID_REQUESTS_PER_10_SECONDS": 50,
  },
  "d1_databases": [
    {
      "binding": "QUOTA_DB",
      "database_name": "keyQuota",
      "database_id": "f6f0fb21-c9d4-4c31-bf9d-373e1bcbaaa6",
    },
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 10,
      },
    },
  ],
}
